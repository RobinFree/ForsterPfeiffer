import xml.etree.ElementTree as ET

# XML-Datei einlesen
baum = ET.parse('Pfeifer1.xml')  # <-- Hier steht jetzt dein Dateiname
wurzel = baum.getroot()

# Alle Orte auflisten
print("Gefundene Orte:")
for ort in wurzel.findall('ort'):
    name = ort.find('name').text
    land = ort.find('land').text
    print(f"{name} ({land})")
