   "source": [
    "import xml.etree.ElementTree as ET\n",
    "\n",
    "def extract_places(xml_file):\n",
    "    \"\"\"Liest eine TEI-XML-Datei ein und extrahiert Ortsnamen.\"\"\"\n",
    "    tree = ET.parse(xml_file)\n",
    "    root = tree.getroot()\n",
    "\n",
    "    # TEI-Namespace (falls nötig)\n",
    "    ns = {'tei': 'http://www.tei-c.org/ns/1.0'}\n",
    "\n",
    "    # Suche nach allen <placeName>-Einträgen\n",
    "    places = [place.text for place in root.findall(\".//tei:placeName\", ns) if place.text]\n",
    "\n",
    "    return places\n",
    "\n",
    "# Dateien einlesen\n",
    "file1 = \"pfeiffer_frauenfahrt01_1850.TEI-P5.xml\"\n",
    "file2 = \"forster_reise01_1778.TEI-P5.xml\"\n",
    "\n",
    "places_pfeiffer = extract_places(file1)\n",
    "places_forster = extract_places(file2)\n",
    "\n",
    "print(\"Orte in Pfeiffers Reise:\", places_pfeiffer)\n",
    "print(\"Orte in Forsters Reise:\", places_forster)"
   ]
  }
